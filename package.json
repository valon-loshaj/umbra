{
  "name": "umbra",
  "version": "0.1.0",
  "description": "Semantic search for Obsidian using local vector embeddings",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "semantic-search",
    "vector-search",
    "lancedb"
  ],
  "author": {
    "name": "valon-loshaj",
    "email": "valonloshaj@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.19.0",
    "obsidian": "latest",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.23.0",
    "@xenova/transformers": "^2.17.2"
  }
}
